generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Store {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  category  String
  template  String
  email     String
  whatsapp  String
  logoUrl   String?   // <-- TIENE QUE ESTAR ESTA LÍNEA
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  stock     Int      @default(0)
  imageUrl  String?
  category  String?  // <-- NUEVO CAMPO
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}