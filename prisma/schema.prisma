generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Store {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  category  String
  template  String
  email     String
  whatsapp  String
  logoUrl   String?
  userId    String?   // <-- NUEVO CAMPO
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  stock     Int      @default(0)
  imageUrl  String?
  category  String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}